<script>
  function selectSession(buttonElement, cardCount) {
    const chips = document.querySelectorAll('.session-chip');
    chips.forEach(chip => {
      chip.classList.remove('active-chip', 'bg-[#291C0E]', 'border-[#291C0E]', 'text-[#FDF9F3]', 'font-bold', 'shadow-md', 'shadow-[#291C0E]/15');
      chip.classList.add('bg-white', 'border-[#E6DFD5]', 'text-[#241B14]');
      const sub = chip.querySelector('.font-label-meta');
      if (sub) {
        sub.classList.remove('text-[#FDF9F3]/80');
        sub.classList.add('text-text-secondary');
      }
    });

    buttonElement.classList.remove('bg-white', 'border-[#E6DFD5]', 'text-[#241B14]');
    buttonElement.classList.add('active-chip', 'bg-[#291C0E]', 'border-[#291C0E]', 'text-[#FDF9F3]', 'font-bold', 'shadow-md', 'shadow-[#291C0E]/15');
    const activeSub = buttonElement.querySelector('.font-label-meta');
    if (activeSub) {
      activeSub.classList.remove('text-text-secondary');
      activeSub.classList.add('text-[#FDF9F3]/80');
    }

    const counter = document.getElementById('sessionCardsCount');
    if (counter) {
      counter.textContent = cardCount;
    }
  }

  function playAudioPronunciation(btn) {
    const icon = btn.querySelector('.material-symbols-outlined');
    if (icon) {
      icon.textContent = 'graphic_eq';
      btn.classList.add('text-[#0F766E]');
      setTimeout(() => {
        icon.textContent = 'volume_up';
        btn.classList.remove('text-[#0F766E]');
      }, 900);
    }
  }
