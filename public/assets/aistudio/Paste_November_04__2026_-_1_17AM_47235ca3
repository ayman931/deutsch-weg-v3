<script>
  function selectSession(buttonElement, cardCount) {
    const chips = document.querySelectorAll('.session-chip');
    chips.forEach(chip => {
      chip.classList.remove('active-chip', 'bg-accent-sand', 'text-surface', 'font-bold', 'shadow-md', 'shadow-accent-sand/15');
      chip.classList.add('bg-surface-card', 'text-on-surface-variant');
      const sub = chip.querySelector('.font-label-meta');
      if (sub) {
        sub.classList.remove('text-surface/80');
        sub.classList.add('text-text-secondary');
      }
    });

    buttonElement.classList.remove('bg-surface-card', 'text-on-surface-variant');
    buttonElement.classList.add('active-chip', 'bg-accent-sand', 'text-surface', 'font-bold', 'shadow-md', 'shadow-accent-sand/15');
    const activeSub = buttonElement.querySelector('.font-label-meta');
    if (activeSub) {
      activeSub.classList.remove('text-text-secondary');
      activeSub.classList.add('text-surface/80');
    }

    const counter = document.getElementById('sessionCardsCount');
    if (counter) {
      counter.textContent = cardCount;
    }
  }

  function playAudioPronunciation(btn) {
    const icon = btn.querySelector('.material-symbols-outlined');
    if (icon) {
      icon.textContent = 'graphic_eq';
      btn.classList.add('text-feedback-correct');
      setTimeout(() => {
        icon.textContent = 'volume_up';
        btn.classList.remove('text-feedback-correct');
      }, 900);
    }
  }
