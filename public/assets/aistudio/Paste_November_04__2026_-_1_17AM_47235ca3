        if (isHidden) {
          grammarPanel.classList.remove('hidden');
          grammarPanel.classList.add('flex');
          if (accordionArrow) accordionArrow.style.transform = 'rotate(180deg)';
        } else {
          grammarPanel.classList.add('hidden');
          grammarPanel.classList.remove('flex');
          if (accordionArrow) accordionArrow.style.transform = 'rotate(0deg)';
        }
      });
    }

    // Audio Playback Ripple Simulation
    const audioBtn = document.getElementById('audio-pronounce-btn');
    const audioIcon = document.getElementById('audio-icon');

    if (audioBtn) {
      audioBtn.addEventListener('click', function() {
        if (audioIcon) {
          audioIcon.textContent = 'spatial_audio_off';
          setTimeout(function() {
            audioIcon.textContent = 'volume_up';
          }, 800);
        }
      });
    }

    // Bookmark Toggle
    const bookmarkBtn = document.getElementById('bookmark-btn');
    if (bookmarkBtn) {
      bookmarkBtn.addEventListener('click', function() {
        const icon = bookmarkBtn.querySelector('.material-symbols-outlined');
        if (icon) {
          const isFilled = icon.style.fontVariationSettings && icon.style.fontVariationSettings.includes("'FILL' 1");
          icon.style.fontVariationSettings = isFilled ? "'FILL' 0" : "'FILL' 1";
          bookmarkBtn.classList.toggle('text-[#b45309]');
        }
      });
    }

    // SRS Response Feedback Interaction
    const srsButtons = document.querySelectorAll('.srs-action-btn');
    srsButtons.forEach(function(btn) {
      btn.addEventListener('click', function() {
        btn.classList.add('scale-90', 'opacity-70');
        setTimeout(function() {
          btn.classList.remove('scale-90', 'opacity-70');
        }, 180);
      });
    });
  })();
